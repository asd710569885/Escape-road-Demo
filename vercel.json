{
  "version": 2,
  "builds": [
    { 
      "src": "api/index.js", 
      "use": "@vercel/node" 
    },
    { 
      "src": "Escape-road/package.json", 
      "use": "@vercel/static-build",
      "config": {
        "distDir": "Escape-road/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Headers": "Origin, X-Requested-With, Content-Type, Accept, Authorization",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS"
      },
      "dest": "api/index.js",
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/Escape-road/dist/index.html"
    }
  ],
  "env": {
    "KV_URL": "@kv_url",
    "KV_REST_API_TOKEN": "@kv_rest_api_token",
    "NODE_ENV": "production"
  }
}
